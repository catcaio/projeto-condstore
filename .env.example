# CONDSTORE OS - Environment Variables Example Template
# Copie este arquivo para .env.local para desenvolvimento local.
# NÃO commite arquivos .env com valores reais.

# --- Core Infrastructure ---
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
DATABASE_URL="mysql://USER:PASSWORD@HOST:PORT/DB?ssl={\"rejectUnauthorized\":true}"
REDIS_URL="rediss://default:PASSWORD@HOST:PORT"

# --- Security & Auth ---
# AUTH_SECRET: Segredo para JWT (mínimo 32 bytes)
AUTH_SECRET="<32_BYTE_RANDOM_STRING>"
# PII_ENCRYPTION_KEY: Chave para criptografia de PII (64 hex chars ou 32 bytes base64)
PII_ENCRYPTION_KEY="<64_HEX_CHARACTERS>"

# --- Internal Tokens (Service-to-Service) ---
ADMIN_TOKEN="<RANDOM_TOKEN>"
BOOTSTRAP_TOKEN="<RANDOM_TOKEN>"
CRON_TOKEN="<RANDOM_TOKEN>"
QA_BOOTSTRAP_TOKEN="<RANDOM_TOKEN>"
INTERNAL_DIAG_TOKEN="<RANDOM_TOKEN>"
INTERNAL_EXPORT_TOKEN="<RANDOM_TOKEN>"
INTERNAL_JOB_TOKEN="<RANDOM_TOKEN>"
SEED_TOKEN="<RANDOM_TOKEN>"
DEMO_ADMIN_PASSWORD="<STRONG_DEMO_PASSWORD_OR_GENERATED_IN_DEV>"
PRINT_SEED_PASSWORD="false"

# --- WhatsApp & Twilio ---
TWILIO_ACCOUNT_SID="<TWILIO_ACCOUNT_SID>"
TWILIO_AUTH_TOKEN="<TWILIO_AUTH_TOKEN>"
TWILIO_WHATSAPP_NUMBER="whatsapp:+14155238886"
TWILIO_WEBHOOK_BASE_URL="https://your-ngrok-url.ngrok.io"

# --- Logistics (Melhor Envio) ---
MELHOR_ENVIO_API_URL="https://www.melhorenvio.com.br/api/v2"
MELHOR_ENVIO_TOKEN="<MELHOR_ENVIO_BEARER_TOKEN>"
MELHOR_ENVIO_CLIENT_ID="<ID>"
MELHOR_ENVIO_CLIENT_SECRET="<SECRET>"

# --- Billing (Stripe) ---
NEXT_PUBLIC_STRIPE_ENABLED="1"
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# --- Google OAuth ---
GOOGLE_CLIENT_ID="<GOOGLE_CLIENT_ID>.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="<GOOGLE_CLIENT_SECRET>"

# --- AI & Vector (Optional/Frozen) ---
# OPENAI_API_KEY="sk-..."
# QDRANT_URL="https://..."
# QDRANT_API_KEY="..."

# --- Email (SMTP) ---
# SMTP_HOST="smtp.example.com"
# SMTP_PORT=587
# SMTP_USER="user@example.com"
# SMTP_PASS="password"
# MAIL_FROM="noreply@condstoreos.com"
