# APP
NODE_ENV=development
APP_URL=http://localhost:3000

# DATABASE (TiDB / MySQL)
# Format: mysql://USER:PASSWORD@HOST:PORT/DB_NAME?ssl={"rejectUnauthorized":true}
DATABASE_URL=mysql://*:*@*:*/*?ssl={"rejectUnauthorized":true}

# TWILIO
TWILIO_ACCOUNT_SID=AC*
TWILIO_AUTH_TOKEN=*
TWILIO_WHATSAPP_NUMBER=whatsapp:+*

# Webhook signature verification
# Set to the public base URL of your deployment (e.g. https://yourapp.vercel.app).
# Must match EXACTLY the URL configured in the Twilio console (no trailing slash).
# If omitted, the URL is reconstructed from x-forwarded-proto/x-forwarded-host headers.
# Required in production to prevent webhook spoofing.
TWILIO_WEBHOOK_BASE_URL=https://your-app.example.com

# Set to "false" ONLY for local dev (disables HMAC validation entirely).
# NEVER set "false" in production.
TWILIO_SIGNATURE_VALIDATION_ENABLED=true

# NGROK (for local webhook testing)
NGROK_URL=https://*.ngrok-free.dev

# CACHE (Optional)
# UPSTASH_REDIS_REST_URL=*
# UPSTASH_REDIS_REST_TOKEN=*

# AUTH (JWT session signing — required in production; fallback used in dev only)
# Gerar: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=your-random-secret-here-min-32-chars


## LOCAL DEV (MySQL Docker)
DATABASE_URL="mysql://user:pass@127.0.0.1:3306/lojacond"
AUTH_SECRET="dev-secret-change-me"
NODE_ENV="development"
