# ============================================
# REQUIRED VARIABLES (App won't start without these)
# ============================================

# Database (TiDB)
DATABASE_URL=mysql://user:password@host:4000/database

# Twilio Configuration
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token

# Melhor Envio API
MELHORENVIO_TOKEN=your_melhor_envio_token

# Freight Configuration
ORIGIN_CEP=01001000
TABELA_CSV_URL=https://your-domain.com/tabela.csv

# ============================================
# OPTIONAL VARIABLES (Have defaults)
# ============================================

# Application
NODE_ENV=development
LOG_LEVEL=debug
PORT=3000
SESSION_TTL_HOURS=6

# Twilio Optional
TWILIO_PHONE_NUMBER=whatsapp:+5511999999999
TWILIO_WEBHOOK_TIMEOUT_MS=10000
TWILIO_MAX_RETRIES=3
# Set to 'false' to disable signature validation for local development
TWILIO_SIGNATURE_VALIDATION_ENABLED=true
# Override webhook URL for signature validation (useful with ngrok)
# TWILIO_WEBHOOK_URL=https://your-ngrok-url.ngrok.io/api/webhook

# Redis (Upstash) - Optional, falls back to memory in development
# UPSTASH_REDIS_REST_URL=https://your-upstash-redis-url
# UPSTASH_REDIS_REST_TOKEN=your_upstash_token

# Melhor Envio Optional
MELHORENVIO_API_URL=https://www.melhorenvio.com.br/api/v2
MELHORENVIO_TIMEOUT_MS=15000
MELHORENVIO_MAX_RETRIES=2
MELHORENVIO_RETRY_DELAY_MS=1000

# Freight Defaults
DEFAULT_UNIT_WEIGHT_KG=0.3
MAX_FREIGHT_OPTIONS=3

# Multi-Tenant
TENANT_CACHE_TTL_MINUTES=10

# Internal API (for maintenance routes)
# INTERNAL_API_KEY=your_secret_internal_key_here
