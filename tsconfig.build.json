{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "noEmit": true,
        "skipLibCheck": true
    },
    "include": [
        "src/**/*",
        "next-env.d.ts"
    ],
    "exclude": [
        "node_modules",
        ".next",
        "dist",
        "coverage",
        "scripts/**/*",
        "**/__tests__/**",
        "**/*.test.ts",
        "**/*.spec.ts",
        "vitest.config.ts",
        "src/legacy/**/*"
    ]
}