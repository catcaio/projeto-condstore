{
  "name": "condstore-os",
  "version": "1.0.0",
  "license": "MIT",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "lint:ops": "node -e \"require('fs').existsSync('infra/systemd/condstore-finops-worker.service') || (console.error('MISSING: infra/systemd/condstore-finops-worker.service'), process.exit(1))\"",
    "lint:env": "node ./scripts/check-env-leak.mjs",
    "lint:pii": "node scripts/verify-no-plaintext-pii.mjs",
    "lint:secrets-critical": "node scripts/check-critical-secrets.mjs",
    "check:boundaries": "node --import tsx scripts/check-import-boundaries.ts",
    "install:clean": "cmd /c \"if exist node_modules rmdir /s /q node_modules & if exist package-lock.json del /f /q package-lock.json & call scripts\\npm-safe.cmd\"",
    "install:safe": "cmd /c \"call scripts\\npm-safe.cmd\"",
    "postinstall": "node scripts/patch-next-lint.mjs",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "typecheck:mvp": "tsc -p tsconfig.mvp.json --noEmit",
    "test": "npm run test:ci",
    "test:ci": "npm run lint:env && npm run lint:pii && npm run lint:secrets-critical && cross-env ESBUILD_BINARY_PATH=node_modules/vite/node_modules/@esbuild/win32-x64/esbuild.exe NODE_OPTIONS=--require=./scripts/vitest-windows-eperm-workaround.cjs VITEST_POOL=threads vitest run --configLoader runner --config vitest.config.mjs",
    "test:coverage": "npm run lint:env && npm run lint:pii && cross-env ESBUILD_BINARY_PATH=node_modules/vite/node_modules/@esbuild/win32-x64/esbuild.exe NODE_OPTIONS=--require=./scripts/vitest-windows-eperm-workaround.cjs VITEST_POOL=forks vitest run --configLoader runner --config vitest.config.mjs --coverage",
    "test:win-stable": "cross-env ESBUILD_BINARY_PATH=node_modules/vite/node_modules/@esbuild/win32-x64/esbuild.exe NODE_OPTIONS=--require=./scripts/vitest-windows-eperm-workaround.cjs VITEST_POOL=forks vitest run --configLoader runner --config vitest.config.mjs",
    "test:whatsapp": "npm run test:win-stable -- src/modules/atendimento/__tests__ src/app/api/whatsapp/incoming/__tests__ src/server/twilio/__tests__ \"src/app/(app)/cockpit/atendimento/__tests__\" src/app/api/cockpit/conversations src/__tests__/middleware.test.ts src/__tests__/rbac-guards.test.ts",
    "test:cockpit": "npm run test:win-stable -- src/modules/cockpit \"src/app/(app)/cockpit/__tests__\" \"src/app/(app)/cockpit/components/__tests__\" src/app/api/cockpit/metrics src/app/api/cockpit/ops src/app/api/cockpit/timeline src/app/api/cockpit/custom-fields src/__tests__/cockpit-observability.test.ts",
    "test:freight": "npm run test:win-stable -- src/modules/freight src/modules/logistics src/modules/logistica src/modules/pedidos src/modules/shipping src/app/api/public/cotacao src/app/api/orders \"src/app/api/cockpit/conversations/[id]/quotes\" src/infra/__tests__/freight-table.test.ts",
    "test:mvp": "npm run test:win-stable -- src/mvp/",
    "guardrail:mvp-freeze": "node scripts/verify-mvp-freeze.mjs",
    "guardrail:mvp-baseline": "node scripts/verify-mvp-freeze.mjs",
    "scope:pr-tests": "node scripts/pr-test-scope.mjs",
    "release:check": "node scripts/release-check.mjs",
    "staging:smoke": "node --import tsx scripts/smoke/staging-smoke.ts",
    "db:push": "drizzle-kit generate && drizzle-kit migrate",
    "db:verify": "node --import tsx scripts/db-verify.ts",
    "routes:inventory": "node --import tsx scripts/routes-inventory.ts",
    "routes:verify": "node --import tsx scripts/routes-verify.ts",
    "routes:sync": "npm run routes:inventory && npm run routes:verify",
    "routes:verify-security": "node --import tsx scripts/routes-verify-security.ts",
    "verify:tenant-isolation": "node --import tsx scripts/verify-tenant-isolation.ts",
    "validate:sandbox": "node --env-file=.env.local --import tsx scripts/validate-sandbox.ts",
    "qa:snapshots": "node --import tsx scripts/qa-snapshots.ts",
    "lint:design-system": "vitest run src/__tests__/design-system.test.ts",
    "worker:finops": "node --import tsx src/workers/finops-worker.ts",
    "ai:eval": "node --import tsx src/core/ai/evals/eval-runner.ts",
    "stripe:listen": "stripe listen --forward-to localhost:3015/api/webhook/stripe",
    "stripe:trigger:checkout": "stripe trigger checkout.session.completed",
    "stripe:trigger:invoice": "stripe trigger invoice.paid",
    "stripe:trigger:cancel": "stripe trigger customer.subscription.deleted",
    "seed:demo-tenant": "node --import tsx scripts/seed-mvp-demo-tenant.ts",
    "tenant:readiness": "node --env-file=.env.local --import tsx scripts/validate-first-tenant-readiness.ts",
    "freight:readiness": "node --env-file=.env.local --import tsx scripts/validate-freight-readiness.ts",
    "whatsapp:readiness": "node --env-file=.env.local --import tsx scripts/validate-whatsapp-readiness.ts",
    "billing:readiness": "node --env-file=.env.local --import tsx scripts/validate-billing-readiness.ts",
    "tracking:readiness": "node --env-file=.env.local --import tsx scripts/validate-tracking-readiness.ts",
    "cockpit:smoke": "node --env-file=.env.local --import tsx scripts/validate-cockpit-smoke.ts",
    "pilot:readiness": "node --env-file=.env.local --import tsx scripts/validate-pilot-launch-readiness.ts",
    "auth:readiness": "node --env-file=.env.local --import tsx scripts/validate-auth-readiness.ts",
    "email:readiness": "node --env-file=.env.local --import tsx scripts/validate-email-readiness.ts",
    "mvp:release-candidate": "node --env-file=.env.local --import tsx scripts/validate-mvp-release-candidate.ts",
    "bela:update": "./scripts/bela-update.sh"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1000.0",
    "@aws-sdk/s3-request-presigner": "^3.1000.0",
    "@sentry/nextjs": "^10.40.0",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.13.19",
    "@vercel/speed-insights": "^1.3.1",
    "axios": "^1.20.0",
    "clsx": "2.1.1",
    "date-fns-tz": "3.2.0",
    "dotenv": "17.3.1",
    "drizzle-orm": "0.45.2",
    "framer-motion": "^12.35.0",
    "ioredis": "^5.9.3",
    "jose": "6.1.3",
    "lucide-react": "0.574.0",
    "mysql2": "3.24.2",
    "next": "16.3.3",
    "nodemailer": "^9.1.0",
    "openai": "^6.29.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "stripe": "^20.4.0",
    "swr": "^2.4.1",
    "tailwind-merge": "3.4.1",
    "tailwindcss-animate": "1.0.7",
    "twilio": "5.12.1",
    "uuid": "^14.0.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "9.39.3",
    "@playwright/test": "^1.58.2",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.3.3",
    "@types/node-fetch": "2.6.13",
    "@types/nodemailer": "^8.0.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/uuid": "^10.0.0",
    "@vitest/coverage-v8": "4.0.18",
    "autoprefixer": "10.4.24",
    "cross-env": "10.1.0",
    "drizzle-kit": "0.31.9",
    "eslint": "9.39.3",
    "eslint-config-next": "^16.1.6",
    "node-fetch": "3.3.2",
    "pdf-parse": "^2.4.5",
    "postcss": "^8.5.26",
    "tailwindcss": "3.4.19",
    "ts-node": "10.9.2",
    "tsx": "^4.21.0",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.56.0",
    "vitest": "4.0.18",
    "xlsx": "^0.18.5"
  },
  "overrides": {
    "minimatch": ">=10.2.3",
    "eslint": "9.39.3",
    "@eslint/js": "9.39.3",
    "serialize-javascript": "7.0.5",
    "fast-xml-parser": "5.7.3",
    "follow-redirects": "1.16.0",
    "vite": "8.0.16",
    "brace-expansion": "5.0.9",
    "flatted": ">=3.4.0",
    "esbuild": ">=0.25.0",
    "fast-uri": "3.1.6",
    "browserslist": ">=4.28.7",
    "postcss-selector-parser": ">=6.1.3"
  }
}
